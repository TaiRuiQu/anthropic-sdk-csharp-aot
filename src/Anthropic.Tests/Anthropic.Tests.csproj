<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!-- Run tests on net8.0, net10.0 (which use the SDK's matching .NET DLL), and on net472, which
    uses the SDK's netstandard2.0 DLL. An AOT build only targets .NET 10. -->
    <TargetFrameworks Condition="'$(PublishAot)' != 'true'">net8.0;net10.0;net472</TargetFrameworks>
    <TargetFrameworks Condition="'$(PublishAot)' == 'true'">net10.0</TargetFrameworks>

    <!-- Disable skipped tests warnings. -->
    <NoWarn>$(NoWarn),xUnit1004</NoWarn>

    <!-- The test project isn't an AOT publish target; its reflection-based framework would only add
    analyzer noise to an AOT build of the solution. -->
    <EnableAotAnalyzer Condition="'$(PublishAot)' == 'true'">false</EnableAotAnalyzer>
    <EnableTrimAnalyzer Condition="'$(PublishAot)' == 'true'">false</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="xunit.v3" Version="3.2.1" />
    <PackageReference Include="xunit.analyzers" Version="1.26.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="..\Anthropic\Anthropic.csproj" />
    <ProjectReference Include="..\Anthropic.Foundry\Anthropic.Foundry.csproj" />
    <ProjectReference Include="..\Anthropic.Bedrock\Anthropic.Bedrock.csproj" />
    <ProjectReference Include="..\Anthropic.Aws\Anthropic.Aws.csproj" />
    <ProjectReference Include="..\Anthropic.Vertex\Anthropic.Vertex.csproj" />
    <ProjectReference Include="..\Anthropic.GoogleCloud\Anthropic.GoogleCloud.csproj" />
    <ProjectReference Include="..\Anthropic.Mcp\Anthropic.Mcp.csproj" />
    <EmbeddedResource Include="Helpers\FableFallback\*.sse" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
