<Project>
  <Import Project="Versions.props" />
  <PropertyGroup>
    <Authors>TairuiQu</Authors>
    <Company>TairuiQu</Company>
    <PackageTags>anthropic;claude;sdk;api;http;library;native-aot;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright 2023 Anthropic, PBC; fork modifications Copyright 2026 TairuiQu</Copyright>
    <PackageProjectUrl>https://github.com/TairuiQu/anthropic-sdk-csharp-aot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TairuiQu/anthropic-sdk-csharp-aot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Strong naming -->
    <AssemblyOriginatorKeyFile>../../Open.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <!-- Documentation-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Disable missing XML documentation warnings. -->
    <NoWarn>$(NoWarn),1573,1591</NoWarn>

    <!-- Source link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>embedded</DebugType>

    <!-- netstandard2.0 has no Native AOT support, so an AOT build targets .NET 10 only. -->
    <TargetFrameworks Condition="'$(PublishAot)' != 'true'">net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(PublishAot)' == 'true'">net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <BuildPackage>true</BuildPackage>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Disable deprecation warnings since we may reference our own deprecated symbols. -->
    <NoWarn>$(NoWarn),0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <LicenseFile Include="$(MSBuildProjectDirectory)\LICENSE*" />
    <LicenseFile Include="$(MSBuildThisFileDirectory)..\LICENSE*" Exclude="@(LicenseFile->'$(MSBuildThisFileDirectory)..\%(Filename)%(Extension)')" />
    <None Include="@(LicenseFile)" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
