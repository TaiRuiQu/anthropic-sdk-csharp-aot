#!/usr/bin/env bash
# Format staged C# files with csharpier before every commit, then re-stage them.
set -e
cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cs' '*.csproj' || true)
[ -z "$files" ] && exit 0

dotnet tool restore >/dev/null
echo "==> pre-commit: dotnet csharpier format"
echo "$files" | tr '\n' '\0' | xargs -0 dotnet csharpier format
echo "$files" | tr '\n' '\0' | xargs -0 git add --
